[Unit]
Description=Tufty 2040 LCARS System Monitor Sender
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/tufty-lcars-monitor/raspberry
ExecStart=/home/pi/tufty-lcars-monitor/raspberry/.venv/bin/python /home/pi/tufty-lcars-monitor/raspberry/monitor_sender.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target